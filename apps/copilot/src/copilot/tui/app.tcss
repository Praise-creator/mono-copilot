Sidebar {
    width: 30;
    height: 1fr;
    border-right: solid $panel;
}

MainArea {
    width: 1fr;
    height: 1fr;
}

CopilotHeader {
    height: 4;
    padding: 1 2;
    text-style: bold;
    border-bottom: solid $panel;
}

ChatPane{
    height: 1fr;
}

ComposeArea {
    border: round $panel;
    height: 6;
    min-height: 3;
    max-height: 10;
    margin: 1 3;
    padding: 0 2;
}

CopilotStatusBar {
    height: 1;
}

.message {
    width: auto;
    max-width: 80%;
    padding: 0 2;
    margin: 0 1;
}

.assistant-message {
    border: round $primary;
}

.user-message {
    border: round $accent;
}

.sidebar-title {
    text-style: bold;
    padding: 1 2;
}

.sidebar-section {
    padding: 1 2;
    text-style: bold;
}

.sidebar-item  {
    padding: 0 2;
    margin: 0;
}

.new-chat {
    align: center middle;
    width: auto;
    padding: 0 2;
    margin: 0 0 1 0;
    border: round $primary;
    text-style: bold;
}

.brand-row {
    height: 3;
    margin-bottom: 0;
    padding: 0;
}

.current-project {
    padding: 0 2;
    margin: 0;
    text-style: bold;
}

.sidebar-subsection {
    padding: 1 2 0 2;
    text-style: bold;
    color: $text-muted;
}

.loading-message {
    border: round #fdb913;
    color: #fdb913;
}

.sidebar-project-button {
    width: 100%;
    border: round $panel;
    background: $panel 30%;
    color: $text;
    text-align: left;
    min-width: 0;
    margin: 0 0 1 0;
}

.sidebar-project-button:hover {
    background: $panel 60%;
}

.sidebar-project-button.current-project {
    border: round #fdb913;
    background: #fdb913 15%;
    color: #fdb913;
    text-style: bold;
}